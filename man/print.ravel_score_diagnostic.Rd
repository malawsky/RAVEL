\name{print.ravel_score_diagnostic}
\alias{print.ravel_score_diagnostic}
\title{Print an auxiliary unadjusted score diagnostic}
\usage{\method{print}{ravel_score_diagnostic}(x, ...)}
\arguments{
\item{x}{An auxiliary diagnostic returned by \code{\link{ravel_score_diagnostic}}.}
\item{...}{Passed to the underlying diagnostic print method.}
}
\description{Prints the test result together with its auxiliary scope, selected
sample counts, and covariate/interaction omission warnings.}
